{
    "label" : "suspend",
    "action" : "exec ~/.config/i3/scripts/i3lock.sh & systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}

{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}

{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
